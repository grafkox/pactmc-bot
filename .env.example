DISCORD_BOT_TOKEN=dein-bot-token-hier
DISCORD_APPLICATION_ID=deine-application-id-hier

# Optional: für Slash-Command-Tests auf einem Dev-Server.
# Wenn gesetzt UND in src/handlers/loadCommands.js die kommentierte Zeile
# aktiviert wird, registrieren sich Commands instant statt global.
# DEV_GUILD_ID=

# Ticket-Daten (Counter, Tickets, Killswitch, Policy-Profil). Im Container ein Volume mounten.
# TICKET_DATA_FILE=./data/tickets.json
# TICKET_MAX_OPEN_PER_USER=3

# AI Ticket Assistant (Open WebUI, OpenAI-kompatibel).
# Pflicht, sonst bleibt der Assistent inaktiv:
OPENWEBUI_BASE_URL=https://example.com/api
OPENWEBUI_API_KEY=

# Optional, Defaults stehen in src/config.js:
# GATE_MODEL=pact-gate
# ANSWER_MODEL=pact-answer
# OPENWEBUI_TIMEOUT_MS=30000
# TICKET_ASSISTANT_ENABLED=true
# TICKET_ASSISTANT_VERBOSE=true
# DEBOUNCE_SECONDS=4
# MAX_AUTO_REPLIES=5

# Gate: openwebui (altes Gate), shadow (altes Gate entscheidet, lokales läuft mit) oder ollama.
# Das lokale Modell braucht Ollama ab 0.35.0 (Endpoint /v1/systemone).
# GATE_MODE=openwebui
# OLLAMA_BASE_URL=http://localhost:11434
# ROUTER_MODEL=nimble:latest
# ROUTER_TIMEOUT_MS=5000
# ROUTER_CONTEXT_MESSAGES=3
# ROUTER_FALLBACK=escalate
# ROUTER_LOG_FILE=./data/router-log.jsonl

# Console-Zugang per RCON (beide Ziele optional, ein Ziel ohne Host/Passwort ist nicht nutzbar).
# VELOCITY_RCON_HOST=
# VELOCITY_RCON_PORT=25575
# VELOCITY_RCON_PASSWORD=
# LEAF_RCON_HOST=
# LEAF_RCON_PORT=25575
# LEAF_RCON_PASSWORD=
# SUPERVISOR_MODEL=pact-terminal-supervisor
# ACTION_MAX_CYCLES=3
# MC_RATE_LIMIT_PER_USER=5
# RCON_TIMEOUT_MS=5000
# MC_DRY_RUN=false
# MC_PROTECTED_PLAYERS=Name1,Name2

# Server-Logs (read-only mounten)
# SERVER_LOGS_ENABLED=true
# VELOCITY_LOGS_PATH=/data/logs/velocity/logs
# LEAF_LOGS_PATH=/data/logs/leaf/logs

# @-Erwähnung: Kontext aus den letzten N Nachrichten, höchstens H Stunden alt
# MENTION_CONTEXT_MESSAGES=15
# MENTION_CONTEXT_HOURS=48

# ID-Overrides nur fürs lokale Testen (sonst Defaults aus config.js), kommagetrennt:
# TICKET_CATEGORY_IDS=
# SUPPORT_ROLE_IDS=
